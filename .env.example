PORT=3000

# Local: laisser vide pour utiliser SQLite dans data/marketplace.db.
# Production Render/Neon: coller ici la connection string PostgreSQL Neon.
DATABASE_URL=

# Avec Neon, garder SSL actif.
PGSSL=require

# Production: definir un mot de passe pour proteger l'administration.
# Local: laisser vide si tu veux tester sans mot de passe.
ADMIN_PASSWORD=
